# Normalize EOL for all files that Git considers text files.
* text=auto eol=lf

# Binary formats — keep as normal git blobs (not LFS). Mark -text so
# `* text=auto` does not rewrite EOL in these files.

# Godot specific binaries
*.res -text

# Image formats
*.bmp -text
*.dds -text
*.exr -text
*.hdr -text
*.jpg -text
*.jpeg -text
*.png -text
*.tga -text
*.svg -text
*.webp -text

# Audio and Video formats
*.mp3 -text
*.wav -text
*.ogg -text
*.ogx -text
*.ogv -text

# 3D formats
*.gltf -text
*.blend -text
*.blend1 -text
*.glb -text
*.dae -text
*.obj -text
*.fbx -text

# Build / packaging
*.dll -text
*.dylib -text
*.zip -text
*.7z -text
*.gz -text
*.rar -text
*.tar -text
*.file -text
