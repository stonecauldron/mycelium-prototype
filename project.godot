; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Auto Shrooms"
run/main_scene="res://assets/title/title.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.png"

[autoload]

GameState="*res://assets/autoload/game_state.gd"
ActionFeedback="*res://assets/ui/action_feedback/action_feedback.gd"
SceneTransition="*res://assets/autoload/scene_transition.gd"
Screenshot="*res://assets/autoload/screenshot.gd"
SettingsServer="*res://assets/autoload/settings_server.gd"
DebugMode="*res://assets/autoload/debug_mode.gd"
Analytics="*res://assets/autoload/analytics.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/size/mode.editor=0
window/size/mode.web=0
window/size/mode.macos=3
window/size/mode.windows=3

[global_group]

combat_world=""

[gui]

timers/tooltip_delay_sec=0.2
theme/custom="res://assets/themes/default.tres"

[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="player_units"
2d_physics/layer_3="hurtbox"
2d_physics/layer_4="hitbox"
2d_physics/layer_5="enemy_units"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
textures/vram_compression/import_etc2_astc=true
