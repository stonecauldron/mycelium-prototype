@@ -1,7 +1,30 @@
 class_name ProjectileBlocker
 extends Area2D
 
-## Mounted on weapon appearances (e.g. umbrella canopy). Destroys opposing projectiles.
+## Mounted on weapon appearances (e.g. umbrella canopy). Intercepts opposing projectiles.
+
+@onready var _canopy: CollisionPolygon2D = $CollisionPolygon2D
+
+
+## Nearest canopy edge in world space, including facing flips and weapon poses.
+func surface_contact_at(world_position: Vector2) -> Dictionary:
+	var points := _canopy.global_transform * _canopy.polygon
+	var closest_distance := INF
+	var contact := world_position
+	var normal := Vector2.UP
+	var signed_area := 0.0
+	for i in points.size():
+		var start := points[i]
+		var end := points[(i + 1) % points.size()]
+		signed_area += start.cross(end)
+		var closest := Geometry2D.get_closest_point_to_segment(world_position, start, end)
+		var distance := world_position.distance_squared_to(closest)
+		if distance < closest_distance:
+			closest_distance = distance
+			contact = closest
+			var edge := end - start
+			normal = Vector2(edge.y, -edge.x).normalized()
+	return {"position": contact, "normal": normal if signed_area > 0.0 else -normal}
 
 
